# نمونه‌ی تنظیمات. نصب‌کننده (install.sh) فایل واقعی /opt/vpnbot/.env را خودش می‌سازد.
# این فایل را هرگز با مقدار واقعی توی گیت‌هاب نگذار.

BOT_TOKEN=123456:ABC...             # توکن ربات از BotFather
ADMIN_IDS=111111111                 # آیدی عددی ادمین اصلی (چند تا؟ با کاما)
OUTLINE_API_URL=https://IP:PORT/SECRET
OUTLINE_CERT_SHA256=<64 hex>        # certSha256 اوتلاین
HOSTS=ir1.example.com,ir2.example.com   # دامنه‌های ورودی که توی لینک مشتری می‌آید
CARD_INFO=6037-XXXX-XXXX-XXXX به نام ...
SUPPORT_USERNAME=your_support       # بدون @
WEBAPP_URL=https://app.example.com  # خالی = بدون مینی‌اپ
WEB_PORT=8080

PRICE_PER_GB=5000                   # تومان
PLAN_SIZES=20,40,60,80,100          # گیگ
ADDON_SIZES=10,20,40,60,100         # گیگ
TRAFFIC_FACTOR=2                    # خرید ۱۰ گیگ ← سقف ۵ گیگ روی اوتلاین
GRACE_DAYS=7                        # مهلت تمدید بعد از انقضا (۰ = حذف فوری)
